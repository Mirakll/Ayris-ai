{
  "schema_version": 2,
  "kind": "command",
  "folders": [
    {"path": ["Примеры", "Режимы"], "sort_order": 0}
  ],
  "commands": [
    {
      "name": "Рабочий режим",
      "description": "Пример логики: переменные, ветка If и два звука на разных этапах.",
      "tags": ["режимы", "пример"],
      "folder": ["Примеры", "Режимы"],
      "enabled": true,
      "priority": 0,
      "cooldown_ms": 0,
      "require_admin": false,
      "triggers": [
        {"type": "voice", "phrase": "айрис рабочий режим", "fuzzy": true, "regex": false, "priority": 50, "enabled": true, "conditions": {}}
      ],
      "actions": [
        {"type": "SetVar", "params": {"name": "work_mode", "value": true, "scope": "global"}, "enabled": true, "comment": "", "on_error": "stop"},
        {"type": "If", "params": {"condition": "{work_mode}"}, "then": [
          {"type": "ToastNotify", "params": {"title": "Рабочий режим", "message": "Не отвлекаться ближайшие {focus_minutes} минут"}, "enabled": true, "comment": "", "on_error": "continue"}
        ], "enabled": true, "comment": "", "on_error": "stop"},
        {"type": "OverlayLog", "params": {"message": "Рабочий режим включён"}, "enabled": true, "comment": "", "on_error": "continue"}
      ],
      "variables": [
        {"name": "focus_minutes", "type": "int", "scope": "profile", "default": 60, "persistent": true}
      ],
      "sounds": [
        {"stage": "on_start", "source": "builtin", "value": "start"},
        {"stage": "on_success", "source": "builtin", "value": "success"}
      ],
      "created_at": "2026-01-01T00:00:00Z",
      "updated_at": "2026-01-01T00:00:00Z"
    }
  ]
}
