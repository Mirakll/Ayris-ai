Windows Registry Editor Version 5.00

; Разрешает песочнице Claude выход в сеть к нужным хостам.
; Ключ coworkEgressAllowedHosts должен быть строкой (REG_SZ), внутри — JSON-массив.
; Применяется при старте: после импорта ПОЛНОСТЬЮ закрыть Claude и открыть заново.
;
; agentrouter.org удалять нельзя — это шлюз к самой модели.

[HKEY_CURRENT_USER\SOFTWARE\Policies\Claude]
"coworkEgressAllowedHosts"="[\"agentrouter.org\",\"github.com\",\"api.github.com\",\"codeload.github.com\",\"raw.githubusercontent.com\",\"objects.githubusercontent.com\",\"*.githubusercontent.com\",\"pypi.org\",\"files.pythonhosted.org\",\"registry.npmjs.org\",\"claude.com\",\"docs.claude.com\"]"
