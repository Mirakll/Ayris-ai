  "commands": [
    {
      "name": "Рабочий режим",
      "description": "Пример 2 из раздела 22 ТЗ: переменные, ветка и два звука на успех.",
      "tags": [
        "режимы"
      ],
      "folder": [
        "Режимы"
      ],
      "enabled": true,
      "priority": 0,
      "cooldown_ms": 0,
      "require_admin": false,
      "triggers": [
        {
          "type": "voice",
          "phrase": "айрис рабочий режим",
          "fuzzy": true,
          "regex": false,
          "priority": 50,
          "enabled": true,
          "conditions": {}
        },
        {
          "type": "hotkey",
          "combo": "ctrl+alt+w",
          "enabled": true
        }
      ],
      "actions": [
        {
          "type": "SetVar",
          "params": {
            "name": "work_mode",
            "value": true,
            "scope": "global"
          },
          "enabled": true,
          "comment": "",
          "on_error": "stop"
        },
        {
          "type": "RunApp",
          "params": {
            "app": "code",
            "arguments": ""
          },
          "enabled": true,
          "comment": "",
          "on_error": "stop"
        },
        {
          "type": "RunApp",
          "params": {
            "app": "chrome",
            "arguments": "--profile-directory=Work"
          },
          "enabled": true,
          "comment": "",
          "on_error": "stop"
        },
        {
          "type": "If",
          "params": {
            "condition": "{work_monitor_brightness} > 0"
          },
          "then": [
            {
              "type": "SetBrightness",
              "params": {
                "monitor": "external_1",
                "level": "{work_monitor_brightness}"
              },
              "enabled": true,
              "comment": "",
              "on_error": "stop"
            }
          ],
          "enabled": true,
          "comment": "",
          "on_error": "stop"
        }
      ],
      "variables": [
        {
          "name": "work_monitor_brightness",
          "type": "int",
          "scope": "profile",
          "default": 70,
          "persistent": true
        }
      ],
      "sounds": [
        {
          "stage": "on_success",
          "source": "tts",
          "value": "Рабочий режим активирован. Хорошего кода!"
        },
        {
          "stage": "on_success",
          "source": "file",
          "value": "work_mode_start.wav"
        }
      ],
      "created_at": "2026-01-01T00:00:00Z",
      "updated_at": "2026-01-01T00:00:00Z"
    }
  ]
